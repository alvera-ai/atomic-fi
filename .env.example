# ─── Seeded identity & REST API key (Docker) ───────────────────────────
# These are read by docker-compose.yml (with these exact values as the
# built-in defaults) and seeded into the DB on first `docker compose up`.
# They work out of the box — uncomment/change only to use your own.
#
# ROOT_API_KEY is the bearer for the REST API: send it as `X-API-Key`, e.g.
#   curl -H "X-API-Key: alvera_root_api_key_dev" http://localhost:4100/api/account-holders
# ADMIN_USER / ADMIN_PASS are the admin login for the UI/session endpoints.
ROOT_API_KEY=alvera_root_api_key_dev
ADMIN_USER=admin@atomic-fi.local
ADMIN_PASS=admin-password-dev
TENANT_NAME=atomic-fi-tenant

# Lotus AI — model and API key for the embedded SQL copilot.
LOTUS_AI_MODEL=google:gemini-2.5-flash
LOTUS_AI_API_KEY=your-api-key-here

# CopilotKit runtime — AI sidebar in the JDM rule editor.
# Overrides external-deps/copilot-runtime/docker.env defaults (ollama).
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=your-api-key-here
